__pycache__/
*.pyc
*.db
*.db-journal
*.db-wal
*.db-shm
.venv/

# Audit anchoring artifacts. The signing key must never be committed --
# publishing it would let anyone forge checkpoints and defeat the control.
*.anchor-key
*.anchors.jsonl
witness.jsonl

# Edge agent runtime state (buffered observations may contain plate reads).
edge_buffer.jsonl
edge_processed.json
captures/

# Data-encryption key. Committing it would make encryption at rest pointless.
*.data-key
